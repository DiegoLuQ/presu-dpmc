# ==============================================================================
# Fullstack Next.js + FastAPI .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (NUNCA subir credenciales o variables de entorno)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.template
*.local
incio.txt

# ------------------------------------------------------------------------------
# 2. Node.js & Next.js (Frontend)
# ------------------------------------------------------------------------------
**/node_modules/
node_modules/
.pnp
.pnp.js

# Next.js build output & cache
**/.next/
.next/
out/
build/
dist/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js / TypeScript build info
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Python & FastAPI (Backend)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
develop-eggs/
.eggs/
*.egg-info/
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Databases & local logs
*.sqlite
*.sqlite3
*.db
*.log
backend/app.log
logs/

# ------------------------------------------------------------------------------
# 4. Hojas de Cálculo, Datos y Documentos Locales (Excel, CSV, Office)
# ------------------------------------------------------------------------------
*.xlsx
*.xls
*.xlsm
*.csv
*.docx
*.doc
*.pptx
*.pdf

# ------------------------------------------------------------------------------
# 5. Notas, Planes de Trabajo y Análisis Markdown (manteniendo READMEs y skills)
# ------------------------------------------------------------------------------
*.md
!README.md
!**/README.md
!.agents/skills/**

# Archivos de texto plano de notas personales / temporales
*.txt
!requirements.txt
!**/requirements.txt

# Carpetas o archivos de pruebas / manuales temporales
descargas_manual_cuentas/
Skills/multi_provider_ai_skill.md

# Archivos comprimidos y respaldos
*.zip
*.tar.gz
*.tar
*.rar
*.7z
*.sql.bak
*.sql.tmp

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Tools
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude / Gemini / Agentes / Scratch local
.claude/
.gemini/
scratch/
**/scratch/
**/.tempmediaStorage/

# ------------------------------------------------------------------------------
# 7. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
nul

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# ------------------------------------------------------------------------------
# 8. Temporary & Backup Files
# ------------------------------------------------------------------------------
*.bak
*.backup
*.old
*.orig
*.tmp
*~

# Ejemplo de variables con valores sensibles: no versionar
.env.example
