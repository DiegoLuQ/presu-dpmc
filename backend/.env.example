# Configuración de la API FastAPI
PROJECT_NAME="MCDP School ERP"

# Base de Datos (MySQL)
# Ejemplo: mysql+pymysql://usuario:password@host:puerto/nombre_db
DATABASE_URL="mysql+pymysql://mcdp_user:mcdp_password@localhost:3306/mcdp_db"

# Seguridad
# En producción, genera una clave segura con: openssl rand -hex 32
JWT_SECRET="your-secret-key-here-super-secure"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS - Orígenes permitidos (URL del Frontend)
# Para múltiples orígenes, usa formato JSON: ["http://localhost:3000", "https://miapp.com"]
ALLOW_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3000", "http://127.0.0.1:3001"]
